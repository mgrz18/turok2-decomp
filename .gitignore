# ROM dumps — never commit
baserom*.z64
baserom*.n64
baserom*.v64
*.z64
*.n64
*.v64

# Build artifacts
build/
*.o
*.a
*.elf
*.bin
*.map

# Splat outputs (regenerated from baserom). Anchored at repo root so
# we don't accidentally ignore src/us/, include/us/, etc.
.splat_cache

# Extracted microcode blobs (regenerable from baserom)
ucode/
/us/
/eu/
/jp/
/us/asm/
/us/assets/
/us/bin/

# Tool caches
__pycache__/
*.pyc
.venv/

# External reference repos (cloned locally, not part of this project)
references/

# Vendored toolchain & headers — populated locally by
# scripts/setup-from-references.sh from references/. Third-party origin,
# not under our license.
tools/sn64/
tools/psyq-obj-parser
tools/n64crc
include/types/
include/libtengine/

# Generated symbol seeds (derived from third-party functions.csv)
versions/functions.csv.libtengine
versions/symbol_addrs.us.txt
versions/undefined_funcs_auto.us.txt
versions/undefined_syms_auto.us.txt
versions/symbols_from_lnk.us.txt

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Seeds recuperados del ROM por tools/function_seed.py (regenerables en segundos)
versions/symbols_from_scan.us.txt
versions/*.libtengine-bak
versions/undefined_funcs_extra.us.txt

# Instrucciones de workspace para Claude Code — locales, no se publican
CLAUDE.md
