# turok2_data: the game's data/rodata/bss as C, generated by
# tools/port/gendata.py into port/gen/ (gitignored: it is ROM content).
# docs/port/DATA.md. Generate it once turok2_game is built:
#
#   python3 tools/port/gendata.py --build <out>     # writes port/gen/*.c
#   cmake <out>                                      # picks the files up
#
# The files hold no game types: plain byte arrays and packed structs whose
# pointer members are relocations, so they compile without the game headers.

# gendata.py reads the exact compile flags of each game file from compile_commands.json:
# CMAKE_EXPORT_COMPILE_COMMANDS is set in port/CMakeLists.txt, before turok2_game exists
# (the property is taken when a target is created; set here it missed every game file).

set(T2_GEN_DIR ${T2_REPO_DIR}/port/gen CACHE PATH "gendata.py output (data_*.c, relocs.c)")
file(GLOB T2_DATA_SOURCES CONFIGURE_DEPENDS ${T2_GEN_DIR}/*.c)
if(T2_DATA_SOURCES)
    add_library(turok2_data STATIC ${T2_DATA_SOURCES})
    # -w: the initializers are byte lists and (void *) relocations, nothing to warn about
    target_compile_options(turok2_data PRIVATE -w)
    list(LENGTH T2_DATA_SOURCES n_data)
    message(STATUS "turok2_data: ${n_data} generated files from ${T2_GEN_DIR}")
else()
    message(STATUS "turok2_data: no generated data in ${T2_GEN_DIR} (run tools/port/gendata.py)")
endif()
